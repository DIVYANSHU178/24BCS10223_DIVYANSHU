public class CLASS_1 {
    public static void main(String[] args){
        String a="new";                        // stores string in string pool and give its memory refrence to a
        String b=a;                            // directly assign the refrence of a to b
        // first search value--"got it" in string pool and if not found then it save it and give the new refrence to a
        String c="new";
        String e="mark me";// first search value-- "new" in string pool and if found then give same refrence to c also
        String d=new String("mark me");// stores string in heap in case of new keyword

        System.out.println(a==b);
        System.out.println(a==c);
        System.out.println(e==d);
        System.out.println(e.equals(d));

        // String builder is not thread safe but String Buffer is thread safe and uses synchronization
        // String Buffer uses char array with initial capacity of 16 characters and if it acceeds it make new array with size- (old cap*2)+2
    }
}
